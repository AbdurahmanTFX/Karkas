@block libs.code
purpose tree-sitter code analysis, drift checks, code generation
kind    leaf
thread  any
est     L
fn      check_drift(Schema) -> Issue[]
fn      gen_cmake(Schema) -> string
fn      write_mocks(Schema, block) -> Result<GenResult>
fn      init_project(path, idea) -> Result<InitResult>
call    libs.index:update
call    libs.runner:build
use     libs.core
inv     generated files are deterministic
inv     a leaf without a link cannot include another leaf api
