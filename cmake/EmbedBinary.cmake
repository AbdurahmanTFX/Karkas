# Build-time script: embeds binary files (the application icon, ADR 0046) into a C++ source as byte arrays.
#   cmake -DOUT=<file.cpp> -DNAME=<function> -DLIST=<file with one path per line> -P EmbedBinary.cmake
# The source defines `std::vector<std::span<const unsigned char>> NAME()` in namespace kk::gui.
set(out "// Generated by cmake/EmbedBinary.cmake. Do not edit.\n#include <span>\n#include <vector>\n\nnamespace kk::gui {\nnamespace {\n")
file(STRINGS "${LIST}" FILES)
set(i 0)
foreach(f IN LISTS FILES)
  file(READ "${f}" hex HEX)
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
  string(REGEX REPLACE "(0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,)" "\\1\n" bytes "${bytes}")
  string(APPEND out "// ${f}\nconst unsigned char kFile${i}[] = {\n${bytes}};\n")
  math(EXPR i "${i} + 1")
endforeach()
string(APPEND out "}  // namespace\n\nstd::vector<std::span<const unsigned char>> ${NAME}() {\n  return {")
math(EXPR last "${i} - 1")
foreach(k RANGE ${last})
  string(APPEND out "std::span<const unsigned char>(kFile${k}), ")
endforeach()
string(APPEND out "};\n}\n\n}  // namespace kk::gui\n")
file(WRITE "${OUT}.tmp" "${out}")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUT}.tmp")
