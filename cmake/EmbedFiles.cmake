# Build-time script: embeds text files into a C++ source as raw string literals.
#   cmake -DOUT=<file.cpp> -DROOT=<dir> -DLIST=<file with one path per line> -P EmbedFiles.cmake
file(STRINGS "${LIST}" FILES)
set(out "// Generated by cmake/EmbedFiles.cmake. Do not edit.\n")
string(APPEND out "#include \"kk/templates.hpp\"\n\nnamespace kk::templates {\nnamespace {\n")
string(APPEND out "struct Entry {\n  std::string_view path;\n  std::string_view data;\n};\n")
string(APPEND out "constexpr Entry kEntries[] = {\n")
foreach(f IN LISTS FILES)
  file(READ "${ROOT}/${f}" content)
  string(FIND "${content}" ")KKEMBED" bad)
  if(NOT bad EQUAL -1)
    message(FATAL_ERROR "EmbedFiles: ${f} contains the raw-string delimiter")
  endif()
  string(APPEND out "    {\"${f}\", R\"KKEMBED(${content})KKEMBED\"},\n")
endforeach()
string(APPEND out "};\n}  // namespace\n\n")
string(APPEND out "std::optional<std::string_view> get(std::string_view path) {\n")
string(APPEND out "  for (const auto& e : kEntries) {\n    if (e.path == path) return e.data;\n  }\n  return std::nullopt;\n}\n\n")
string(APPEND out "std::vector<std::string_view> list(std::string_view prefix) {\n")
string(APPEND out "  std::vector<std::string_view> r;\n  for (const auto& e : kEntries) {\n")
string(APPEND out "    if (e.path.starts_with(prefix)) r.push_back(e.path);\n  }\n  return r;\n}\n\n")
string(APPEND out "}  // namespace kk::templates\n")
file(WRITE "${OUT}.tmp" "${out}")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUT}.tmp")
